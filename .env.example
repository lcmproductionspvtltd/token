# ---------------------------------------------------------------
# BQuee configuration. Copy to .env and adjust.
# ---------------------------------------------------------------

# PostgreSQL connection.
# Over the internet (Neon, Supabase, RDS…) add ?sslmode=verify-full – the
# server's certificate is then checked (and sslrootcert=/path/ca.pem if your provider has its own CA).
# In production the server refuses to start on an unchecked connection to a public host. A private
# network address (localhost, 10.x, a Docker service name) is allowed, with a warning.
DATABASE_URL=postgres://bquee:bquee@localhost:5432/bquee

# Web server
PORT=3000
NODE_ENV=production
# "Today" (token dates, daily numbers) is the UTC day everywhere, so TZ no longer changes anything for tokens.
# Times are shown in each person's own clock (browser / phone). Leave TZ unset or UTC.

# This site's address – used for the http→https redirect and to check where browser requests come
# from, e.g. PUBLIC_URL=https://bquee.com
PUBLIC_URL=

# REQUIRED in production: 32+ characters of random text that encrypt two-step sign-in secrets
# (e.g. `openssl rand -base64 48`). The server will not start without it. Keep the same value on
# every server and every deploy. To change it, see "Secrets" in docs/OPERATIONS.md (APP_SECRET_PREVIOUS).
APP_SECRET=

# First super admin – created on first start if none exists. Its password needs 12+ characters.
# Leave ADMIN_PASSWORD empty to get a random password printed in the log.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 1 when running behind Nginx / Caddy / a load balancer
# Behind a proxy (Nginx, a load balancer): the number of proxies in front, e.g. TRUST_PROXY=1.
TRUST_PROXY=0
# Optional: a header the edge sets with the visitor's address that visitors can't fake
# (Cloudflare: true-client-ip or cf-connecting-ip).
CLIENT_IP_HEADER=


# "Continue with Google / Apple" for business owners. Leave empty to hide a button.
# Return addresses to register with Google and Apple: <PUBLIC_URL>/api/oauth/google/callback
# and <PUBLIC_URL>/api/oauth/apple/callback. Steps: docs/OPERATIONS.md, "Google and Apple sign-in".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The text of the AuthKey_XXXX.p8 file on one line, with \n where the line breaks are.
APPLE_PRIVATE_KEY=

# Email codes (sign-up check, "Forgot password", sign-in after many wrong passwords) are sent over SMTP by
# BQuee's own sender (no package). Live setup: ZeptoMail – SMTP_HOST=smtp.zeptomail.in, SMTP_PORT=587,
# SMTP_USER=emailapikey, SMTP_PASSWORD=<the agent's Send Mail token>, MAIL_FROM=info@bquee.com.
# Left empty = codes are off and the website hides "Forgot password" and the sign-up code.
# EMAIL_CODES=off switches them off on purpose.
# Port 465 is encrypted from the start; 587 uses STARTTLS. The certificate is always checked.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# required = every new sign-up must confirm its email with a code. Keep "optional" until the new app
# versions (with the code step) are live in the stores – older apps sign up without a code.
EMAIL_CHECK=optional
EMAIL_CODES=

# Where uploaded images (logos, photos) are stored:
#   disk      files in UPLOADS_DIR (default)
#   database  inside PostgreSQL – use this on hosts whose disk is wiped on restart (free cloud plans)
UPLOADS_STORAGE=disk
UPLOADS_DIR=storage/uploads

# 1 = load the demo salon on first start when the database is empty
SEED_DEMO_DATA=0

# Built-in HTTPS (optional – phones need https for the camera scanner).
# Create a test certificate with: sh scripts/make-cert.sh <your-LAN-IP>
HTTPS_CERT=
HTTPS_KEY=
# Also listen on this port and redirect http → https (e.g. 80)
HTTP_REDIRECT_PORT=

# Used by `npm test` only – this database is WIPED by the tests.
TEST_DATABASE_URL=postgres://bquee:bquee@localhost:5432/bquee_test
